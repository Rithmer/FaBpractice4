{
  "name": "practice-22",
  "version": "1.0.0",
  "description": "Практика 22: балансировка нагрузки в веб-приложениях",
  "private": true,
  "main": "backend.js",
  "scripts": {
    "start": "node start-all.js",
    "backend:1": "node backend.js --port 3000 --name backend-1 --role primary",
    "backend:2": "node backend.js --port 3001 --name backend-2 --role primary",
    "backend:3": "node backend.js --port 3002 --name backend-3 --role backup",
    "check": "node --check backend.js && node --check start-all.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  }
}
